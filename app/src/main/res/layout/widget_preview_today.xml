<?xml version="1.0" encoding="utf-8"?>
<!-- Static mock shown in the widget picker (android:previewLayout); the live
     widget is rendered by Glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/preview_widget_bg"
    android:padding="8dp"
    tools:ignore="HardcodedText,UseAppTint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/smart_today"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_preview_primary"
            android:textSize="16sp" />
        <ImageView
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:contentDescription="@null"
            android:background="@drawable/preview_pill"
            android:backgroundTint="@color/widget_preview_primary"
            android:src="@drawable/floret_ic_widget_add"
            android:tint="@color/widget_preview_on_primary" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="4dp">
        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:maxWidth="160dp"
            android:maxHeight="160dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            android:contentDescription="@null"
            android:src="@drawable/preview_ring" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="4/6"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="22sp" />
    </FrameLayout>
</LinearLayout>
