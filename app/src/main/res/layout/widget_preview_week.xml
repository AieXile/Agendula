<?xml version="1.0" encoding="utf-8"?>
<!-- Static mock shown in the widget picker (android:previewLayout); the live
     widget is rendered by Glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/preview_widget_bg"
    android:padding="4dp"
    tools:ignore="HardcodedText,UseAppTint">

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_tile"
            android:backgroundTint="@color/widget_preview_primary_container"
            android:padding="8dp">
            <LinearLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/preview_circle"
                android:backgroundTint="@color/widget_preview_primary">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_weekday_mon"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_preview_on_primary"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="17"
                    android:textColor="@color/widget_preview_on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/floret_ic_widget_checklist"
                    android:tint="@color/widget_preview_on_primary_container" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="2"
                    android:textColor="@color/widget_preview_on_primary_container"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_tile"
            android:backgroundTint="@color/widget_preview_surface_variant"
            android:padding="8dp">
            <LinearLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/preview_circle"
                android:backgroundTint="@color/widget_preview_surface">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_weekday_tue"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_preview_variant"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="18"
                    android:textColor="@color/widget_preview_variant"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/floret_ic_widget_checklist"
                    android:tint="@color/widget_preview_variant" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1"
                    android:textColor="@color/widget_preview_variant"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_tile"
            android:backgroundTint="@color/widget_preview_surface_variant"
            android:padding="8dp">
            <LinearLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/preview_circle"
                android:backgroundTint="@color/widget_preview_surface">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_weekday_wed"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_preview_variant"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="19"
                    android:textColor="@color/widget_preview_variant"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/floret_ic_widget_checklist"
                    android:tint="@color/widget_preview_variant" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textColor="@color/widget_preview_variant"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>

    <FrameLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:paddingHorizontal="2dp">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/preview_tile"
            android:backgroundTint="@color/widget_preview_surface_variant"
            android:padding="8dp">
            <LinearLayout
                android:layout_width="38dp"
                android:layout_height="38dp"
                android:orientation="vertical"
                android:gravity="center"
                android:background="@drawable/preview_circle"
                android:backgroundTint="@color/widget_preview_surface">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="@string/widget_preview_weekday_thu"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/widget_preview_variant"
                    android:textSize="10sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:includeFontPadding="false"
                    android:text="20"
                    android:textColor="@color/widget_preview_variant"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <ImageView
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:layout_marginEnd="2dp"
                    android:contentDescription="@null"
                    android:src="@drawable/floret_ic_widget_checklist"
                    android:tint="@color/widget_preview_variant" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="3"
                    android:textColor="@color/widget_preview_variant"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
