<?xml version="1.0" encoding="utf-8"?>
<!-- Static mock shown in the widget picker (android:previewLayout); the live
     widget is rendered by Glance. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/preview_widget_bg"
    android:paddingHorizontal="8dp"
    android:paddingVertical="4dp"
    tools:ignore="HardcodedText,UseCompoundDrawables,UseAppTint">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="36dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="@string/smart_today"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/widget_preview_primary"
            android:textSize="16sp" />
        <ImageView
            android:layout_width="36dp"
            android:layout_height="28dp"
            android:padding="5dp"
            android:contentDescription="@null"
            android:background="@drawable/preview_pill"
            android:backgroundTint="@color/widget_preview_primary"
            android:src="@drawable/floret_ic_widget_add"
            android:tint="@color/widget_preview_on_primary" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/widget_tasks_header_gap"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/preview_row"
        android:backgroundTint="@color/widget_preview_surface_variant"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:contentDescription="@null"
            android:src="@drawable/floret_ic_widget_check"
            android:tint="@color/widget_preview_variant" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_task_plants"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/preview_row"
        android:backgroundTint="@color/widget_preview_surface_variant"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:contentDescription="@null"
            android:src="@drawable/floret_ic_widget_check"
            android:tint="@color/widget_preview_variant" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_task_dentist"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="10:30"
                android:textColor="@color/widget_preview_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:minHeight="40dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/preview_row"
        android:backgroundTint="@color/widget_preview_surface_variant"
        android:paddingHorizontal="8dp"
        android:paddingVertical="6dp">
        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:padding="6dp"
            android:contentDescription="@null"
            android:src="@drawable/floret_ic_widget_check"
            android:tint="@color/widget_preview_variant" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:orientation="vertical">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="@string/widget_preview_task_groceries"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="14sp" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="18:00"
                android:textColor="@color/widget_preview_variant"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
